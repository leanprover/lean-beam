# Copy only the native payload into a Lean toolchain prefix; never modify user configuration.
cmake_minimum_required(VERSION 3.21)
if(NOT DEFINED PREFIX OR NOT DEFINED LEAN_PREFIX)
  message(FATAL_ERROR "pass -DLEAN_PREFIX=/build/lean/installation -DPREFIX=/install/prefix")
endif()
get_filename_component(BEAM_SOURCE "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
include("${BEAM_SOURCE}/.lake/toolchain-build.cmake")
if(NOT BEAM_BUILD_SOURCE_COMMIT)
  message(FATAL_ERROR "missing Beam source commit; rerun scripts/build-toolchain.cmake")
endif()
if(CMAKE_HOST_WIN32)
  set(EXE ".exe")
  set(PLUGIN "beam_Beam_LSP.dll")
elseif(CMAKE_HOST_APPLE)
  set(EXE "")
  set(PLUGIN "libbeam_Beam_LSP.dylib")
else()
  set(EXE "")
  set(PLUGIN "libbeam_Beam_LSP.so")
endif()
execute_process(COMMAND "${LEAN_PREFIX}/bin/lean${EXE}" --version
  OUTPUT_VARIABLE LEAN_VERSION OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
if(NOT LEAN_VERSION STREQUAL BEAM_BUILD_LEAN_VERSION)
  message(FATAL_ERROR "selected Lean changed since the Beam build; rebuild Beam")
endif()
if(EXISTS "${PREFIX}/bin/lean${EXE}")
  execute_process(COMMAND "${PREFIX}/bin/lean${EXE}" --githash
    OUTPUT_VARIABLE INSTALLED_GITHASH OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  if(NOT INSTALLED_GITHASH STREQUAL BEAM_BUILD_LEAN_GITHASH)
    message(FATAL_ERROR "install prefix contains a different Lean compiler; select the matching prefix")
  endif()
endif()
set(BUILD "${BEAM_SOURCE}/.lake/toolchain-build")
foreach(ARTIFACT "bin/beam-cli${EXE}" "bin/beam-daemon${EXE}" "bin/lean-beam-mcp${EXE}" "lib/${PLUGIN}")
  file(SHA256 "${BUILD}/${ARTIFACT}" HASH)
  if(NOT HASH STREQUAL BEAM_BUILD_HASH_${ARTIFACT})
    message(FATAL_ERROR "${ARTIFACT} changed since the native build; rerun scripts/build-toolchain.cmake")
  endif()
endforeach()
set(PRIVATE "${PREFIX}/lib/lean-beam")
file(MAKE_DIRECTORY "${PREFIX}/bin" "${PRIVATE}")
file(COPY_FILE "${BUILD}/bin/beam-cli${EXE}" "${PREFIX}/bin/lean-beam${EXE}" ONLY_IF_DIFFERENT)
file(COPY_FILE "${BUILD}/bin/beam-daemon${EXE}" "${PREFIX}/bin/beam-daemon${EXE}" ONLY_IF_DIFFERENT)
file(COPY_FILE "${BUILD}/bin/lean-beam-mcp${EXE}" "${PREFIX}/bin/lean-beam-mcp${EXE}" ONLY_IF_DIFFERENT)
file(COPY_FILE "${BUILD}/lib/${PLUGIN}" "${PRIVATE}/${PLUGIN}" ONLY_IF_DIFFERENT)
file(COPY "${BEAM_SOURCE}/LICENSE" DESTINATION "${PRIVATE}")
file(SHA256 "${PREFIX}/bin/lean-beam${EXE}" CLI_HASH)
file(SHA256 "${PREFIX}/bin/beam-daemon${EXE}" DAEMON_HASH)
file(SHA256 "${PREFIX}/bin/lean-beam-mcp${EXE}" MCP_HASH)
file(SHA256 "${PRIVATE}/${PLUGIN}" PLUGIN_HASH)
string(SHA256 PAYLOAD_HASH "${CLI_HASH}:${DAEMON_HASH}:${MCP_HASH}:${PLUGIN_HASH}")

# Compiler version descriptions are data, including custom quotes and control characters.
function(beam_json_string value output)
  string(REPLACE "\\" "\\\\" escaped "${value}")
  string(REPLACE "\"" "\\\"" escaped "${escaped}")
  foreach(code RANGE 1 31)
    string(ASCII ${code} control)
    string(HEX "${control}" hex)
    string(REPLACE "${control}" "\\u00${hex}" escaped "${escaped}")
  endforeach()
  set(${output} "\"${escaped}\"" PARENT_SCOPE)
endfunction()
foreach(field BEAM_BUILD_SOURCE_COMMIT PAYLOAD_HASH BEAM_BUILD_LEAN_VERSION
    BEAM_BUILD_LEAN_GITHASH BEAM_BUILD_LAKE_VERSION)
  beam_json_string("${${field}}" ${field}_JSON)
endforeach()
file(WRITE "${PRIVATE}/provenance.json"
  "{\"schemaVersion\":1,\"sourceCommit\":${BEAM_BUILD_SOURCE_COMMIT_JSON},\"payloadHash\":${PAYLOAD_HASH_JSON},\"leanVersion\":${BEAM_BUILD_LEAN_VERSION_JSON},\"leanGithash\":${BEAM_BUILD_LEAN_GITHASH_JSON},\"lakeVersion\":${BEAM_BUILD_LAKE_VERSION_JSON}}\n")
