# Copy a validated native payload into staging; never modify user configuration.
cmake_minimum_required(VERSION 3.21)
if(NOT DEFINED PREFIX OR NOT DEFINED LEAN_PREFIX)
  message(FATAL_ERROR "pass -DLEAN_PREFIX=/build/lean/installation -DPREFIX=/install/prefix")
endif()
get_filename_component(BEAM_SOURCE "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
include("${BEAM_SOURCE}/scripts/toolchain-manifest.cmake")
set(MANIFEST "${BEAM_SOURCE}/.lake/toolchain-build.json")
file(READ "${MANIFEST}" RECORD)
string(JSON SCHEMA GET "${RECORD}" schemaVersion)
if(NOT SCHEMA EQUAL 3)
  message(FATAL_ERROR "unsupported native build manifest; rerun scripts/build-toolchain.cmake")
endif()
foreach(FIELD sourceCommit buildId payloadHash)
  string(JSON VALUE GET "${RECORD}" "${FIELD}")
  if(VALUE STREQUAL "")
    message(FATAL_ERROR "missing ${FIELD} in native build manifest; rebuild Beam")
  endif()
endforeach()
beam_validate_components("${RECORD}")
string(JSON RECORDED_REVISION GET "${RECORD}" components frontends compilerRevision)
string(JSON TARGET_REVISION GET "${RECORD}" components targets 0 compilerRevision)
if(NOT TARGET_REVISION STREQUAL RECORDED_REVISION)
  message(FATAL_ERROR "native target compiler revision disagrees with the build record")
endif()
if(CMAKE_HOST_WIN32)
  set(EXE ".exe")
else()
  set(EXE "")
endif()
# The selected source compiler is checked even when the destination is still empty.
execute_process(COMMAND "${LEAN_PREFIX}/bin/lean${EXE}" --githash
  OUTPUT_VARIABLE SOURCE_REVISION OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
if(NOT SOURCE_REVISION STREQUAL RECORDED_REVISION)
  message(FATAL_ERROR "selected Lean compiler revision changed since the Beam build; rebuild Beam")
endif()
if(EXISTS "${PREFIX}/bin/lean${EXE}")
  execute_process(COMMAND "${PREFIX}/bin/lean${EXE}" --githash
    OUTPUT_VARIABLE DESTINATION_REVISION OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  if(NOT DESTINATION_REVISION STREQUAL RECORDED_REVISION)
    message(FATAL_ERROR "install prefix contains a different Lean compiler revision; select the matching prefix")
  endif()
endif()
string(JSON ARTIFACTS GET "${RECORD}" artifacts)
beam_manifest_payload_hash("${RECORD}" PAYLOAD_HASH)
string(JSON RECORDED_HASH GET "${RECORD}" payloadHash)
if(NOT PAYLOAD_HASH STREQUAL RECORDED_HASH)
  message(FATAL_ERROR "native artifact inventory changed since the build; rebuild Beam")
endif()
string(JSON COUNT LENGTH "${ARTIFACTS}")
if(COUNT EQUAL 0)
  message(FATAL_ERROR "native artifact inventory is empty; rebuild Beam")
endif()
math(EXPR LAST "${COUNT}-1")
# Finish all admission and artifact checks before writing the destination.
foreach(INDEX RANGE 0 ${LAST})
  string(JSON ARTIFACT GET "${ARTIFACTS}" ${INDEX})
  beam_manifest_path("${ARTIFACT}" source SOURCE)
  beam_manifest_path("${ARTIFACT}" destination DESTINATION)
  string(JSON EXPECTED GET "${ARTIFACT}" hash)
  file(SHA256 "${BEAM_SOURCE}/${SOURCE}" ACTUAL)
  if(NOT ACTUAL STREQUAL EXPECTED)
    message(FATAL_ERROR "${SOURCE} changed since the native build; rerun scripts/build-toolchain.cmake")
  endif()
endforeach()
foreach(INDEX RANGE 0 ${LAST})
  string(JSON ARTIFACT GET "${ARTIFACTS}" ${INDEX})
  beam_manifest_path("${ARTIFACT}" source SOURCE)
  beam_manifest_path("${ARTIFACT}" destination DESTINATION)
  get_filename_component(PARENT "${PREFIX}/${DESTINATION}" DIRECTORY)
  file(MAKE_DIRECTORY "${PARENT}")
  file(COPY_FILE "${BEAM_SOURCE}/${SOURCE}" "${PREFIX}/${DESTINATION}" ONLY_IF_DIFFERENT)
endforeach()
# Publish the same data record, after the complete listed payload has been copied.
set(PRIVATE "${PREFIX}/lib/lean-beam")
file(COPY_FILE "${MANIFEST}" "${PRIVATE}/provenance.json.tmp")
file(RENAME "${PRIVATE}/provenance.json.tmp" "${PRIVATE}/provenance.json")
