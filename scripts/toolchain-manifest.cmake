# Native build records are data. Keep their artifact inventory and string encoding in one place.
function(beam_json_string value output)
  string(REPLACE "\\" "\\\\" escaped "${value}")
  string(REPLACE "\"" "\\\"" escaped "${escaped}")
  foreach(code RANGE 1 31)
    string(ASCII ${code} control)
    string(HEX "${control}" hex)
    string(REPLACE "${control}" "\\u00${hex}" escaped "${escaped}")
  endforeach()
  set(${output} "\"${escaped}\"" PARENT_SCOPE)
endfunction()

function(beam_write_native_manifest output source_root source_commit build_id lean_version lean_revision lake_version)
  if(CMAKE_HOST_WIN32)
    set(exe ".exe")
    set(plugin "beam_Beam_LSP.dll")
  elseif(CMAKE_HOST_APPLE)
    set(exe "")
    set(plugin "libbeam_Beam_LSP.dylib")
  else()
    set(exe "")
    set(plugin "libbeam_Beam_LSP.so")
  endif()
  set(inventory
    ".lake/toolchain-build/bin/beam-cli${exe}|bin/lean-beam${exe}"
    ".lake/toolchain-build/bin/beam-daemon${exe}|bin/beam-daemon${exe}"
    ".lake/toolchain-build/bin/lean-beam-mcp${exe}|bin/lean-beam-mcp${exe}"
    ".lake/toolchain-build/lib/${plugin}|lib/lean-beam/${plugin}"
    "LICENSE|lib/lean-beam/LICENSE")
  set(artifacts "[]")
  set(index 0)
  foreach(entry IN LISTS inventory)
    string(REPLACE "|" ";" paths "${entry}")
    list(GET paths 0 source)
    list(GET paths 1 destination)
    file(SHA256 "${source_root}/${source}" hash)
    set(artifact "{}")
    foreach(field source destination hash)
      beam_json_string("${${field}}" value)
      string(JSON artifact SET "${artifact}" "${field}" "${value}")
    endforeach()
    string(JSON artifacts SET "${artifacts}" ${index} "${artifact}")
    math(EXPR index "${index}+1")
  endforeach()
  set(frontends "{}")
  beam_json_string("bin/lean-beam${exe}" value)
  string(JSON frontends SET "${frontends}" cli "${value}")
  beam_json_string("bin/lean-beam-mcp${exe}" value)
  string(JSON frontends SET "${frontends}" mcp "${value}")
  beam_json_string("${lean_revision}" value)
  string(JSON frontends SET "${frontends}" compilerRevision "${value}")
  set(target "{}")
  foreach(pair "lean|bin/lean${exe}" "daemon|bin/beam-daemon${exe}"
      "plugin|lib/lean-beam/${plugin}" "toolchain|${lean_version}"
      "compilerRevision|${lean_revision}" "leanVersion|${lean_version}" "lakeVersion|${lake_version}")
    # Description strings can contain semicolons; do not turn values into CMake lists.
    string(FIND "${pair}" "|" separator)
    string(SUBSTRING "${pair}" 0 ${separator} key)
    math(EXPR start "${separator}+1")
    string(SUBSTRING "${pair}" ${start} -1 data)
    beam_json_string("${data}" value)
    string(JSON target SET "${target}" "${key}" "${value}")
  endforeach()
  set(components "{}")
  string(JSON components SET "${components}" frontends "${frontends}")
  string(JSON components SET "${components}" license "\"lib/lean-beam/LICENSE\"")
  string(JSON components SET "${components}" targets "[${target}]")
  set(record "{\"schemaVersion\":3}")
  string(JSON record SET "${record}" artifacts "${artifacts}")
  string(JSON record SET "${record}" components "${components}")
  beam_validate_components("${record}")
  beam_manifest_payload_hash("${record}" payload_hash)
  foreach(pair "sourceCommit|source_commit" "buildId|build_id" "payloadHash|payload_hash")
    string(REPLACE "|" ";" fields "${pair}")
    list(GET fields 0 key)
    list(GET fields 1 variable)
    beam_json_string("${${variable}}" value)
    string(JSON record SET "${record}" "${key}" "${value}")
  endforeach()
  file(WRITE "${output}.tmp" "${record}\n")
  file(RENAME "${output}.tmp" "${output}")
endfunction()

# Only relative inventory paths may be interpreted by the installer.
function(beam_manifest_path record field output)
  string(JSON kind TYPE "${record}" "${field}")
  if(NOT kind STREQUAL "STRING")
    message(FATAL_ERROR "artifact ${field} must be a string")
  endif()
  string(JSON path GET "${record}" "${field}")
  if(path STREQUAL "" OR IS_ABSOLUTE "${path}" OR path MATCHES "[\\\\:<>\"|?*;]" OR
      path MATCHES "(^|/)(\\.\\.?|)(/|$)")
    message(FATAL_ERROR "invalid native artifact ${field}: ${path}")
  endif()
  string(REPLACE "/" ";" parts "${path}")
  foreach(part IN LISTS parts)
    string(TOLOWER "${part}" lower)
    string(REGEX REPLACE "\\..*$" "" base "${lower}")
    set(reserved con prn aux nul "conin$" "conout$" "clock$"
      com¹ com² com³ lpt¹ lpt² lpt³)
    if(part MATCHES "[. ]$" OR base IN_LIST reserved OR base MATCHES "^(com|lpt)[1-9]$")
      message(FATAL_ERROR "nonportable artifact ${field}: ${path}")
    endif()
  endforeach()
  set(${output} "${path}" PARENT_SCOPE)
endfunction()

# Hash the declared relationships as well as their files. Neither can change within a generation.
function(beam_manifest_payload_hash record output)
  set(payload "{}")
  foreach(field artifacts components)
    string(JSON value GET "${record}" "${field}")
    string(JSON payload SET "${payload}" "${field}" "${value}")
  endforeach()
  string(SHA256 hash "${payload}")
  set(${output} "${hash}" PARENT_SCOPE)
endfunction()

# Completeness comes from the recorded roles; this is not a second hard-coded artifact list.
function(beam_validate_components record)
  foreach(role cli mcp compilerRevision)
    string(JSON kind TYPE "${record}" components frontends "${role}")
    if(NOT kind STREQUAL "STRING")
      message(FATAL_ERROR "frontend ${role} must be a string")
    endif()
  endforeach()
  string(JSON kind TYPE "${record}" components license)
  if(NOT kind STREQUAL "STRING")
    message(FATAL_ERROR "license component must be a string")
  endif()
  string(JSON frontend_revision GET "${record}" components frontends compilerRevision)
  string(LENGTH "${frontend_revision}" revision_length)
  if(NOT revision_length EQUAL 40 OR NOT frontend_revision MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "frontend compiler revision must be an exact Git revision")
  endif()
  string(JSON count LENGTH "${record}" artifacts)
  if(count EQUAL 0)
    message(FATAL_ERROR "installation artifact inventory is empty")
  endif()
  set(destinations "")
  math(EXPR last "${count}-1")
  foreach(index RANGE 0 ${last})
    string(JSON artifact GET "${record}" artifacts ${index})
    beam_manifest_path("${artifact}" source source)
    beam_manifest_path("${artifact}" destination path)
    string(JSON hash GET "${artifact}" hash)
    string(LENGTH "${hash}" hash_length)
    if(NOT hash_length EQUAL 64 OR NOT hash MATCHES "^[0-9a-f]+$")
      message(FATAL_ERROR "artifact hash must be a SHA-256 digest")
    endif()
    string(TOLOWER "${path}" key)
    if(key IN_LIST destinations)
      message(FATAL_ERROR "duplicate artifact destination: ${path}")
    endif()
    list(APPEND destinations "${key}")
  endforeach()
  set(paths "")
  foreach(role cli mcp)
    string(JSON path GET "${record}" components frontends "${role}")
    list(APPEND paths "${path}")
  endforeach()
  string(JSON license GET "${record}" components license)
  list(APPEND paths "${license}")
  string(JSON count LENGTH "${record}" components targets)
  if(NOT count EQUAL 1)
    message(FATAL_ERROR "native installation must contain exactly one target")
  endif()
  string(JSON lean GET "${record}" components targets 0 lean)
  foreach(field lean daemon plugin toolchain leanVersion lakeVersion compilerRevision)
    string(JSON kind TYPE "${record}" components targets 0 "${field}")
    string(JSON value GET "${record}" components targets 0 "${field}")
    if(NOT kind STREQUAL "STRING" OR value STREQUAL "")
      message(FATAL_ERROR "target ${field} must be a nonempty string")
    endif()
  endforeach()
  string(JSON target_revision GET "${record}" components targets 0 compilerRevision)
  if(NOT target_revision STREQUAL frontend_revision)
    message(FATAL_ERROR "native frontend and target compiler revisions differ")
  endif()
  if(CMAKE_HOST_WIN32)
    set(expected_lean "bin/lean.exe")
  else()
    set(expected_lean "bin/lean")
  endif()
  if(NOT lean STREQUAL expected_lean)
    message(FATAL_ERROR "native target must use its containing Lean installation")
  endif()
  foreach(role daemon plugin)
    string(JSON path GET "${record}" components targets 0 "${role}")
    list(APPEND paths "${path}")
  endforeach()
  set(used "")
  foreach(path IN LISTS paths)
    beam_json_string("${path}" value)
    beam_manifest_path("{\"path\":${value}}" path path)
    string(TOLOWER "${path}" key)
    if(key IN_LIST used)
      message(FATAL_ERROR "component path has multiple roles: ${path}")
    endif()
    if(NOT key IN_LIST destinations)
      message(FATAL_ERROR "component is absent from artifact inventory: ${path}")
    endif()
    list(APPEND used "${key}")
  endforeach()
endfunction()
