set -euo pipefail

usage() {
  cat <<'EOF' >&2
usage:
  lean-beam-mcp
  lean-beam-mcp --self-check <lean-file>
  lean-beam-mcp --version

Runs the experimental Lean Beam MCP stdio server.

The server uses only its installation's recorded runtimes. Every
workspace-bound tool request supplies an explicit local workspace descriptor.

--self-check starts a child MCP server and calls lean_sync on <lean-file> in the
current Lean project.

Self-check uses one best-effort probe timeout of 120000 ms; override with
LEAN_BEAM_MCP_SELF_CHECK_TIMEOUT_MS. This setting does not bound total command
duration; blocking I/O and cleanup may outlast it.

--version prints the MCP server version, protocol revision, and resolved runtime
paths.
EOF
}

resolve_script_path() {
  local source="${BASH_SOURCE[0]}"
  local dir=""
  while [ -L "$source" ]; do
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    case "$source" in
      /*)
        ;;
      *)
        source="$dir/$source"
        ;;
    esac
  done
  dir="$(cd -P "$(dirname "$source")" && pwd)"
  printf '%s/%s\n' "$dir" "$(basename "$source")"
}

script_path="$(resolve_script_path)"
script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
beam_home="$(cd -P "$script_dir/.." && pwd)"
beam_bin="$beam_home/libexec/lean-beam-mcp"
if [ ! -x "$beam_bin" ]; then
  echo "missing installed lean-beam-mcp at $beam_bin; run scripts/install-beam.sh" >&2
  exit 1
fi
export BEAM_WRAPPER_PATH="$script_path"
exec "$beam_bin" "$@"
