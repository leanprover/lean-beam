set -euo pipefail

resolve_script_path() {
  local source="${BASH_SOURCE[0]}"
  local dir=""
  while [ -L "$source" ]; do
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    case "$source" in
      /*)
        ;;
      *)
        source="$dir/$source"
        ;;
    esac
  done
  dir="$(cd -P "$(dirname "$source")" && pwd)"
  printf '%s/%s\n' "$dir" "$(basename "$source")"
}

script_path="$(resolve_script_path)"
script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
beam_home="$(cd -P "$script_dir/.." && pwd)"
beam_bin="$beam_home/libexec/lean-beam-mcp"
if [ ! -x "$beam_bin" ]; then
  echo "missing installed lean-beam-mcp at $beam_bin; run scripts/install-beam.sh" >&2
  exit 1
fi
export BEAM_WRAPPER_PATH="$script_path"
exec "$beam_bin" "$@"
